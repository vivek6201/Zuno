{
    "extends": "@repo/typescript-config/base.json",
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"],
    "compilerOptions": {
        "moduleResolution": "bundler",
        "module": "es2022",
        "outDir": "dist",
        "rootDir": "src",
        "paths": {
            "@/*": ["./src/*"]
        }
    }
}
